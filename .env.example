# Base de datos (PostgreSQL via Docker)
DATABASE_URL=postgresql://docai:password@localhost:5432/docai
PGUSER=docai
PGPASSWORD=password
PGDATABASE=docai

# Redis (via Docker)
REDIS_URL=redis://localhost:6379/0

# ── AI Providers ──
# Al menos uno de estos es necesario.
# DeepSeek:  https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Zhipu (GLM): https://open.bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=your_zhipu_api_key_here

# OpenAI (opcional)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (desarrollo gratuito)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Proveedor activo ──
# Modelos disponibles: gemini | deepseek | zhipu | openai
PROVIDER_LLM=gemini
PROVIDER_EMBEDDINGS=api

# Modelos a usar (según provider)
# Gemini:
GEMINI_MODEL_CHAT=gemini-2.0-flash
GEMINI_MODEL_EMBED=text-embedding-004

# ── JWT / Seguridad ──
SIGNING_SECRET=change_me_to_a_random_256bit_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Storage (S3/MinIO) ──
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=docai-documents
S3_ENDPOINT=http://localhost:9000
S3_USE_SSL=false

# ── Entorno ──
ENVIRONMENT=development
DEBUG=true

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=your_nextauth_secret_change_me
NEXTAUTH_URL=http://localhost:3000

# ── Features Flags ──
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_CHAT_PER_MIN=30
GUEST_RATE_LIMIT_PER_MIN=20
ENABLE_FILE_AV_SCAN=false
CLAMAV_PATH=clamscan

# ── Cookies ──
COOKIE_SAMESITE=Lax
COOKIE_SECURE=false

# ── CSRF ──
CSRF_ENABLED=false
CSRF_COOKIE_NAME=XSRF-TOKEN
CSRF_HEADER_NAME=x-csrf-token
CSRF_SAMESITE=Lax
CSRF_MAX_AGE_SECONDS=86400
CSRF_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_SECRET_KEY=

# ── Demo / Guest ──
DEMO_PUBLIC=true
DEMO_REGISTRATION_ENABLED=false
DEMO_GUEST_ENABLED=true
DEMO_AUTO_CLEAN_HOURS=0
DEMO_WHITELIST_EMAILS=

# ── Guest quotas ──
GUEST_MAX_DOCUMENTS=3

# ── Frontend (variables que usa Next.js) ──
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_QR=false
NEXT_PUBLIC_SHOW_DEMO_RESET=false
NEXT_PUBLIC_DEMO_PUBLIC=true
