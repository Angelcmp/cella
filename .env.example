# Database
DATABASE_URL=postgresql://docai:password@localhost:5432/docai
PGUSER=docai
PGPASSWORD=password
PGDATABASE=docai

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini
GEMINI_API_KEY=AIzaSyDu8qEqB_AgVaMTLWv1u2iQwV3RIZqq9H0
# Optional: override default model choices
GEMINI_MODEL_CHAT=gemini-2.0-flash
GEMINI_MODEL_EMBED=text-embedding-004

# JWT / Tokens
SIGNING_SECRET=change_me_to_a_random_256bit_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET=docai-documents

# Environment
ENVIRONMENT=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# Security & Features Flags
# CSP strict mode (enable in production)
ENABLE_CSP_STRICT=false
# Rate limiting master switch
RATE_LIMIT_ENABLED=true
# Per-endpoint thresholds (requests per minute)
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_CHAT_PER_MIN=30
# File antivirus scan (enable in demo pública/producción)
ENABLE_FILE_AV_SCAN=false
# Path to ClamAV executable when scan is enabled (default: clamscan)
CLAMAV_PATH=clamscan

# Cookies
# SameSite policy: Lax (acordado)
COOKIE_SAMESITE=Lax
# Secure cookie only over HTTPS (true en producción/demo pública)
COOKIE_SECURE=false

# Providers (selección por entorno)
PROVIDER_LLM=gemini
PROVIDER_EMBEDDINGS=api

# CSRF protection
CSRF_ENABLED=false
CSRF_COOKIE_NAME=XSRF-TOKEN
CSRF_HEADER_NAME=x-csrf-token
CSRF_SAMESITE=Lax
CSRF_MAX_AGE_SECONDS=86400
# Optional override for allowed origins (comma-separated). Defaults include localhost:3000
CSRF_ALLOWED_ORIGINS=
CSRF_SECRET_KEY=

# Demo pública (endurece defaults en despliegue)
DEMO_PUBLIC=false
DEMO_REGISTRATION_ENABLED=true
DEMO_AUTO_CLEAN_HOURS=0
DEMO_WHITELIST_EMAILS=

# Frontend Demo
NEXT_PUBLIC_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_QR=true
NEXT_PUBLIC_SHOW_DEMO_RESET=false
NEXT_PUBLIC_DEMO_ADMIN_EMAILS=
NEXT_PUBLIC_DEMO_PUBLIC=false
