# ── AI Providers ──
# Al menos uno es necesario para chat.

# DeepSeek (deepseek-v4-flash, deepseek-v4-pro)
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Zhipu (GLM-4.5, GLM-4.7, etc.)
# https://open.bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=your_zhipu_api_key_here

# OpenAI (opcional)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (desarrollo gratuito, recomendado por ahora)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database ──
DATABASE_URL=postgresql://docai:password@localhost:5432/docai

# ── Server ──
API_HOST=0.0.0.0
API_PORT=8000

# ── Provider activo (gemini es el default soportado hoy) ──
PROVIDER_LLM=gemini
PROVIDER_EMBEDDINGS=api
