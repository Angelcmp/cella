# ── AI Providers ──
# Al menos DEEPSEEK_API_KEY + ZHIPU_API_KEY son necesarios para usar Cella.
# DeepSeek:  proveedor principal de chat (rápido y económico)
# Zhipu:     proveedor de embeddings (embedding-2)
# OpenAI:    opcional, puede usarse para chat o embeddings

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Zhipu (GLM): https://open.bigmodel.cn/usercenter/proj-mgmt/apikeys
ZHIPU_API_KEY=your_zhipu_api_key_here

# OpenAI (opcional)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini: no se usa por defecto pero puede configurarse como proveedor adicional.
# GEMINI_API_KEY=your_gemini_api_key_here

# ── Provider activo ──
# Chat: deepseek (principal) o zhipu / openai
# Embeddings: 'local' (fastembed, sin API key), 'zhipu' o 'openai'
PROVIDER_LLM=deepseek
PROVIDER_EMBEDDINGS=local

# ── Database ──
DATABASE_URL=postgresql://docai:password@localhost:5432/docai

# ── Server ──
API_HOST=0.0.0.0
API_PORT=8000

# ── Security ──
SIGNING_SECRET=change_me_to_a_random_256bit_string_at_least_32_chars
CSRF_SECRET_KEY=change_me_to_a_random_256bit_string_at_least_32_chars

# ── Demo / Guest ──
DEMO_PUBLIC=true
DEMO_GUEST_ENABLED=true
COOKIE_SECURE=false
CSRF_ENABLED=true
CSRF_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
